# Brainiac environment configuration (copy to .env or export these).
# The application also reads config.yaml, with environment variables taking
# precedence.

# --- Database ---
DATABASE_URI=postgres://brainiac:brainiac@localhost:5432/brainiac?sslmode=disable

# --- Cache (set CACHE_IN_MEMORY=false to use Redis) ---
CACHE_IN_MEMORY=true
CACHE_URI=redis://localhost:6379/0

# --- HTTP server ---
SERVER_ADDR=:8080

# --- Storage (local filesystem backend) ---
STORAGE_ROOT=./storage
STORAGE_BASE_URL=

# --- Security / JWT ---
# Optional: if empty, a random secret is generated and persisted to config.yaml
# on first start. For multi-instance deployments set one explicitly:
#   openssl rand -base64 48
SECURITY_JWT_SECRET=
SECURITY_JWT_ISSUER=brainiac
SECURITY_JWT_ACCESS_TOKEN_TTL=15m
SECURITY_JWT_REFRESH_TOKEN_TTL=720h
SECURITY_JWT_TOTP_TOKEN_TTL=5m

# --- Registration / Login ---
REGISTRATION_ENABLE=false
REGISTRATION_REQUIRE_EMAIL=false
LOGIN_ENFORCE_EMAIL=false

# --- Compromised password checking ---
SECURITY_PASSWORDS_COMPROMISED_CHECK_PASSWORDS=false
SECURITY_PASSWORDS_COMPROMISED_FILE_PATH=
SECURITY_PASSWORDS_COMPROMISED_REPO_URL=

# --- SMTP ---
SMTP_ENABLE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
